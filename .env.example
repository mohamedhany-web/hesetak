APP_NAME="حصتك"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# CSP: مع APP_DEBUG=true الافتراضي يعطّل CSP (DISABLE_CSP غير معرّف = true). لاختبار صفحة الدفع وفواتيرك محلياً بـ CSP: DISABLE_CSP=false
# DISABLE_CSP=false
# على السيرفر المباشر: ضع رابط الموقع الحقيقي بنفس البروتوكول (https://yourdomain.com)
# إذا بقي APP_URL=localhost أو http بينما الموقع https تنكسر CSS/الصور — الكود يحاول التصحيح تلقائياً
APP_URL=http://localhost

APP_CURRENCY=SAR
APP_CURRENCY_SYMBOL="ر.س"
APP_CURRENCY_LABEL=ريال

# Google OAuth (تسجيل الدخول / إنشاء حساب طالب بـ Google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# قرص ملفات مجتمع الذكاء الاصطناعي (تقديمات المساهمين): local أو r2
FILESYSTEM_DISK_COMMUNITY=local
# شعار لوحة الأدمن: public (محلي + php artisan storage:link) أو r2 لـ Cloudflare R2
ADMIN_BRANDING_DISK=public
# صور صفحة الخدمات العامة: public محلياً، أو r2 لـ Cloudflare R2 (نفس مفاتيح AWS_* أدناه)
SITE_SERVICES_DISK=public
# صور آراء الموقع؛ إن تُرك فارغاً يُستخدم SITE_SERVICES_DISK
# SITE_TESTIMONIALS_DISK=r2
# صور بورتفوليو الطلاب (my-portfolio): public أو r2 (نفس AWS_*)
# PORTFOLIO_DISK=public
# صور ملف المستخدم (بروفايل الطالب/المدرب/الأدمن…): إن تُرك فارغاً يُستخدم PORTFOLIO_DISK ثم public
# USER_PROFILE_DISK=r2
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# البريد: لإرسال رمز المصادقة الثنائية (2FA) للأدمن والمدربين عبر SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=info@mualimx.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@mualimx.com
MAIL_FROM_NAME="${APP_NAME}"

# تنبيه فوري لتذاكر الدعم الفني (عنوان أو أكثر مفصولة بفاصلة — يُفضّل Gmail أو بريد يُراقبونه دائماً)
SUPPORT_ALERT_EMAIL=

# إلزام الأدمن والمدربين بالمصادقة الثنائية (2FA) عبر البريد
ADMIN_2FA_REQUIRED=true

# عام (S3 أو Cloudflare R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# لـ Cloudflare R2: Endpoint من لوحة R2 → Manage R2 API Tokens
# AWS_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
# رابط عام للمتصفح (إلزامي للسرعة على الإنتاج) — من R2 → bucket → Public access → r2.dev
# لا تستخدم cloudflarestorage.com هنا — لا يعمل في <img src="">
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL=
# AWS_URL اختياري إن لم يُضبط R2_PUBLIC_URL (نفس قيمة r2.dev وليس endpoint API)
# AWS_URL=https://pub-xxxxxxxx.r2.dev
AWS_URL=

# قرص مواد المناهج التفاعلية: r2 (Cloudflare) أو public عند غياب المفاتيح
# CURRICULUM_LIBRARY_DISK=r2

# وسائط الموقع (كورسات، باقات، شعار): public أو r2
PUBLIC_MEDIA_DISK=r2
# مكتبة الماتريال (ملفات المحاضرات) — r2 = Cloudflare R2 (نفس AWS_* أعلاه)
LECTURE_MATERIALS_DISK=r2
ADMIN_BRANDING_DISK=r2
# على السيرفر بعد الرفع: APP_URL=https://glottical.com ثم php artisan config:clear && php artisan media:migrate-to-r2
SITE_SERVICES_DISK=r2
HOMEPAGE_SLIDERS_DISK=r2

# بوابة الدفع كاشير — API v3 (Payment Sessions). TEST → test-api.kashier.io ، LIVE → api.kashier.io
KASHIER_MODE=test
KASHIER_TEST_MID=
KASHIER_TEST_API_KEY=
KASHIER_TEST_SECRET=
KASHIER_TEST_BASE_URL=https://checkout.kashier.io
# KASHIER_TEST_API_BASE_URL=https://test-api.kashier.io
KASHIER_LIVE_MID=
KASHIER_LIVE_API_KEY=
KASHIER_LIVE_SECRET=
KASHIER_LIVE_BASE_URL=https://checkout.kashier.io
# KASHIER_LIVE_API_BASE_URL=https://api.kashier.io
KASHIER_CURRENCY=SAR
KASHIER_ALLOWED_METHODS=card,wallet,bank_installments
# رابط العودة بعد الدفع — يجب أن يكون URI صالحاً. للتجربة محلياً: http://127.0.0.1:8000/checkout/kashier/callback
# KASHIER_MERCHANT_REDIRECT_URL=https://yourdomain.com/checkout/kashier/callback

# فواتيرك — التفعيل من لوحة التحكم: /admin/system-settings
# وضع الربط: iframe (إضافة + HMAC) أو api (Bearer + REST: getPaymentmethods / invoiceInitPay)
FAWATERAK_INTEGRATION=iframe
FAWATERAK_ENV=test
# —— IFrame ——
FAWATERAK_VENDOR_KEY=
FAWATERAK_PROVIDER_KEY=
# —— API (Gateway) —— عند FAWATERAK_INTEGRATION=api
FAWATERAK_API_TOKEN=
# FAWATERAK_API_BASE_URL=https://staging.fawaterk.com/api/v2
# FAWATERAK_API_TIMEOUT=45
# نطاق مطابق لحقل Domain في HMAC وللوحة فواتيرك (غالباً https://نطاقك.com بدون / في النهاية — أو اتركه فارغاً ليُستخرج من APP_URL)
# يجب أن يطابق حقل Domain في لوحة فواتيرك وما يرسله المتصفح (غالباً https://نطاقك.com بدون / أخيرة). عند www غير APP_URL عيّنه صراحة.
# FAWATERAK_IFRAME_DOMAIN=https://example.com
# إن طلبت فواتيرك Bearer مختلف عن API Key: FAWATERAK_PLUGIN_BEARER_TOKEN=
FAWATERAK_CURRENCY=SAR
FAWATERAK_VERSION=0
# FAWATERAK_TEST_PLUGIN_URL=https://staging.fawaterk.com/fawaterkPlugin/fawaterkPlugin.min.js?v=1.2
# FAWATERAK_LIVE_PLUGIN_URL=https://app.fawaterk.com/fawaterkPlugin/fawaterkPlugin.min.js

# PayPal — التفعيل وبيانات الاتصال من لوحة التحكم: /admin/payment-gateways
# القيم هنا احتياطية إن لم تُحفظ من الإعدادات
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=SAR
# PAYPAL_HTTP_TIMEOUT=30

# ─── ذكاء حصتك (توليد نصوص — مفاتيح المزوّد) ───
# أنشئ مفتاحاً من لوحة المزوّد (مثلاً AI Studio) ثم الصقه هنا
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_HTTP_TIMEOUT=60
GEMINI_MAX_OUTPUT_TOKENS=8192
# Optional: larger cap for educational game HTML generation
# GEMINI_MAX_OUTPUT_TOKENS_GAME=16384

VITE_APP_NAME="${APP_NAME}"

# حد رفع الملفات للتطبيق (كيلوبايت). 40960 = 40 ميجابايت — يُنصح بضبط PHP/nginx مع Cloudflare
# MAX_UPLOAD_KB=40960
# MAX_UPLOAD_BYTES=41943040

# مواد مكتبة المناهج (رفع إلى R2): 150 × 1024 = 153600 كيلوبايت ≈ 150 ميجابايت — اضبط PHP: upload_max_filesize و post_max_size بما لا يقل عن ذلك
# CURRICULUM_MATERIAL_MAX_UPLOAD_KB=153600

# من هذا الحجم (بايت) يُستخدم رفع R2 متعدد الأجزاء بدل PUT واحد — الافتراضي 12 ميجابايت
# CURRICULUM_R2_MULTIPART_THRESHOLD_BYTES=12582912
# حجم كل جزء (بايت، ≥ 5MB حسب S3). افتراضي 16 ميجابايت — أجزاء أقل وأقل عرضة لأخطاء CORS بين المتصفح وR2
# CURRICULUM_R2_MULTIPART_PART_BYTES=16777216
# true = جرّب PUT مباشر للمتصفح→R2 ثم الاحتياطي عبر الخادم عند الفشل؛ false = كل الأجزاء عبر الخادم (يتجاوز CORS)
# CURRICULUM_R2_MULTIPART_BROWSER_FIRST=true

# تحويل عروض المناهج التفاعلية إلى شرائح (LibreOffice + pdftoppm)
# CURRICULUM_PRESENTATION_CONVERSION_ENABLED=true
# CURRICULUM_PRESENTATION_QUEUE=default
# CURRICULUM_PRESENTATION_SOFFICE_PATH=soffice
# CURRICULUM_PRESENTATION_PDFTOPPM_PATH=pdftoppm
# CURRICULUM_PRESENTATION_TIMEOUT_SECONDS=600
# CURRICULUM_PRESENTATION_IMAGE_FORMAT=png
# CURRICULUM_PRESENTATION_DPI=144
# CURRICULUM_PRESENTATION_THUMB_DPI=72

# شهادة المنصة التلقائية عند إتمام الكورس (PDF بتصميم أكاديمي)
# CERTIFICATE_PLATFORM_AUTO_ON_COMPLETE=true
# CERTIFICATE_ACADEMY_NAME=
# CERTIFICATE_COLOR_PRIMARY=#283593
# CERTIFICATE_COLOR_SECONDARY=#FB5607
# CERTIFICATE_DIRECTOR_NAME=
# CERTIFICATE_DIRECTOR_TITLE=

MAIL_NOTIFY_IN_APP=true

# بث مباشر / Live Meetings — LiveKit
LIVE_PROVIDER=livekit
LIVEKIT_URL=wss://live.hissatak.online
LIVEKIT_PUBLIC_HOST=live.hissatak.online
LIVEKIT_HTTP_URL=http://187.127.87.170:7880
# Same keys as VPS livekit.yaml (required for room tokens)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=21600
# Optional: webhook token for live recordings register API
LIVE_RECORDINGS_WEBHOOK_TOKEN=

